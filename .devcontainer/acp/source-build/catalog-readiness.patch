 async function loadCatalog(client: OpenCodeClient, cwd: string): Promise<Catalog> {
+  const target = process.env.OPENCODE_ACP_REQUIRED_MODEL
+  const deadline = Number(process.env.OPENCODE_ACP_CATALOG_TIMEOUT_MS ?? 30_000)
+  if (!target || !/^[^/\s]+\/\S+$/.test(target)) throw new Error("ACP requires an explicit provider/model target")
+  if (!Number.isInteger(deadline) || deadline < 100 || deadline > 120_000)
+    throw new Error("ACP catalog deadline must be an integer between 100 and 120000 ms")
+  const abort = new AbortController()
+  const timeout = new ACPError.ServiceFailureError({
+    safeMessage: "ACP catalog readiness deadline exceeded",
+    service: "catalog",
+  })
+  const timer = setTimeout(() => abort.abort(timeout), deadline)
+  const expired = new Promise<never>((_, reject) => {
+    abort.signal.addEventListener("abort", () => reject(timeout), { once: true })
+  })
+  try {
+    return await Promise.race([loadReadyCatalog(client, cwd, target, abort.signal), expired])
+  } finally {
+    clearTimeout(timer)
+    abort.abort()
+  }
+}
